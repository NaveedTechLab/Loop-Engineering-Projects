# .env.example — a TEMPLATE, safe to commit (no real secret in here).
#
# For LOCAL runs only: copy this to a real .env file and fill in a value.
# .env itself is gitignored — see .gitignore — so it will never be
# pushed to GitHub, and a cloud Routine will never see it either. That's
# the exact lesson of this project. See README.md.

DRILL_SECRET=put-any-test-value-here
